import numpy as np   
import random
   
# Define problem parameters   
num_customers = 10  # Number of Customers   
num_vehicles = 3    # number of vehicles   
vehicle_capacity = 20  # vehicle capacity   
customer_demands = np.random.randint(1, 10, num_customers)  # Customer Demand   
distance_matrix = np.random.rand(num_customers + 1, num_customers + 1)  # Distance matrix, including warehouse
   
# Constructing a mathematical model for delivery routes   
def calculate_cost(path, distance_matrix, customer_demands, vehicle_capacity):
    cost = 0
    vehicle_loads = [0] * num_vehicles
    vehicle_paths = [[] for _ in range(num_vehicles)]
    vehicle_index = 0
    for i in range(len(path)):
        customer = path[i]
        if vehicle_loads[vehicle_index] + customer_demands[customer - 1] <= vehicle_capacity:
            vehicle_loads[vehicle_index] += customer_demands[customer - 1]
            vehicle_paths[vehicle_index].append(customer)
        else:
            vehicle_index += 1
            if vehicle_index >= num_vehicles:
                # Exceeding the number of vehicles incurs penalty costs
                cost += 1000
                break
            vehicle_loads[vehicle_index] = customer_demands[customer - 1]
            vehicle_paths[vehicle_index].append(customer)
        if i > 0:
            prev_customer = path[i - 1]
            cost += distance_matrix[prev_customer][customer]
    # Return to the warehouse
    for v_path in vehicle_paths:
        if v_path:
            cost += distance_matrix[v_path[-1]][0]
    return cost
   
# Immune clonal algorithm   
def immune_clonal_algorithm(num_antibodies=50, num_generations=100, clone_rate=5):
    # Initialize antibody population
    antibodies = []
    for _ in range(num_antibodies):
        path = list(range(1, num_customers + 1))
        random.shuffle(path)
        antibodies.append(path)

    for _ in range(num_generations):
        # Calculate fitness
        fitness_values = [1 / calculate_cost(antibody, distance_matrix, customer_demands, vehicle_capacity) for antibody in antibodies]
        # Clone operation
        clones = []
        for i in range(num_antibodies):
            clone_num = int(clone_rate * fitness_values[i] / max(fitness_values))
            for _ in range(clone_num):
                clones.append(antibodies[i].copy())
        # Mutation
        for clone in clones:
            index1, index2 = random.sample(range(len(clone)), 2)
            clone[index1], clone[index2] = clone[index2], clone[index1]
        # Select operation
        all_antibodies = antibodies + clones
        all_fitness = [1 / calculate_cost(antibody, distance_matrix, customer_demands, vehicle_capacity) for antibody in all_antibodies]
        sorted_indices = np.argsort(all_fitness)[::-1]
        antibodies = [all_antibodies[i] for i in sorted_indices[:num_antibodies]]

    best_antibody = max(antibodies, key=lambda x: 1 / calculate_cost(x, distance_matrix, customer_demands, vehicle_capacity))
    return best_antibody
   
# Run immune cloning algorithm   
best_path = immune_clonal_algorithm()   
best_cost = calculate_cost(best_path, distance_matrix, customer_demands, vehicle_capacity)   
print("Optimal Path:", best_path)   
print("Optimal cost:", best_cost)

